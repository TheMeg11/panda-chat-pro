DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
# REQUIRED in production (the app refuses to boot without it)
# ---------------------------------------------------------------------------
# Long random string. Encrypts Telegram bot tokens + TOTP secrets at rest
# (AES-256-GCM, domain-separated). Generate: openssl rand -hex 32
# WARNING: rotating APP_SECRET makes stored bot tokens and 2FA secrets
# unreadable — re-save the bot token and have users re-enroll 2FA after rotating.
APP_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Backups (AES-256-GCM encrypted before they are sent to Telegram)
# ---------------------------------------------------------------------------
# DEDICATED key for backup encryption (recommended: generate offline, store a
# copy OUTSIDE Telegram and the server, e.g. printed in a safe). When unset it
# is derived from APP_SECRET with a domain-separated label — works out of the
# box, but then survives no APP_SECRET rotation.
# BACKUP_ENCRYPTION_KEY=
# Telegram chat id that owns the super-admin commands (/backup /restore /platform)
# SUPERADMIN_CHAT_ID=
# Alternative accepted chat id for the super-admin bot (fresh-deploy unlock)
# BACKUP_CHAT_ID=

# ---------------------------------------------------------------------------
# Super Admin console (https://<host>/<ADMIN_PATH>)
# ---------------------------------------------------------------------------
# 6–128 chars: letters, digits, - or _. Leave empty to disable the console (404).
ADMIN_PATH=control-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: use a scrypt hash instead of a plain password (format produced by src/lib/crypto.ts hashPassword)
# ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Delivery: "polling" (default, works on any long-running server) or "webhook"
TELEGRAM_MODE=polling
# Set to "off" to disable the built-in long-polling worker (e.g. when a webhook
# is active, or on secondary instances).
# TELEGRAM_POLLING=off
# Platform bot token fallback until an admin saves one in the panel
# TELEGRAM_BOT_TOKEN=
# Shared secret (min 16 chars) for the platform webhook route
# /api/telegram/webhook/platform — REQUIRED for webhook mode, ignored for polling.
# Generate: openssl rand -hex 24
# WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Public URL
# ---------------------------------------------------------------------------
# Used for invite links, webhook registration. Can also be set in the admin panel.
# APP_URL=https://chat.example.com

# ---------------------------------------------------------------------------
# Media & storage
# ---------------------------------------------------------------------------
# Max upload size in MB (1–64, default 15)
# FILES_MAX_MB=15
# Media retention in hours (default 24 — files are hard-deleted after that)
# FILES_TTL_HOURS=24
# Database size that triggers pruning of old chats in MB (default 800)
# STORAGE_QUOTA_MB=800

# ---------------------------------------------------------------------------
# Privacy / data retention (§4.8 data minimization)
# ---------------------------------------------------------------------------
# Audit-log retention in days (default 90, min 7)
# AUDIT_TTL_DAYS=90
# Session IP/User-Agent retention in days before they are blanked (default 30)
# IP_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Feature flags (all optional, safe defaults)
# ---------------------------------------------------------------------------
# End-to-end encryption for direct messages (default on, per-conversation opt-in)
# E2EE_ENABLED=true
# Interactive onboarding tutorial (default on)
# TUTORIAL_ENABLED=true
# Ship the tightened CSP in Report-Only mode first (§4.9), then enforce
# CSP_REPORT_ONLY=1

# ---------------------------------------------------------------------------
# Background loops
# ---------------------------------------------------------------------------
# Set to "off" to disable the maintenance loop entirely
# MAINTENANCE_LOOP=on
# Set to "off" to disable the nightly backup scheduler
# BACKUP_LOOP=on
