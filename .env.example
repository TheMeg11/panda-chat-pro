DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Encryption key for Telegram bot tokens at rest. Generate a long random value and keep it stable.
APP_SECRET=change-me-to-a-long-random-string

# Super Admin console lives at https://<host>/<ADMIN_PATH> (6–128 chars: letters, digits, - or _).
# Leave any of these empty to disable the admin console entirely (the URL returns 404).
ADMIN_PATH=control-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: use a scrypt hash instead of a plain password (format produced by src/lib/crypto.ts hashPassword)
# ADMIN_PASSWORD_HASH=

# Telegram delivery: "polling" (default, works on any long-running server) or "webhook" (needs public HTTPS APP_URL)
TELEGRAM_MODE=polling
# Set TELEGRAM_POLLING=off to disable the built-in long-polling worker (e.g. on secondary instances).
# TELEGRAM_POLLING=off

# Public base URL used for invite links (can also be set from the admin console)
# APP_URL=https://chat.example.com

# Media uploads -------------------------------------------------------------
# Max upload size in MB (1–64, default 15)
# FILES_MAX_MB=15
# Media retention in hours (default 24 — files are hard-deleted after that)
# FILES_TTL_HOURS=24
# Database size that triggers pruning of old chats in MB (default 800)
# STORAGE_QUOTA_MB=800
# Set to "off" to disable the background maintenance loop entirely
# MAINTENANCE_LOOP=on
